// ═══════════════════════════════════════════════════════════════
// INVENTORY MANAGEMENT
// ═══════════════════════════════════════════════════════════════

enum InventoryCategory {
  COSMETOLOGY_INJECTABLES // botox, fillers, mesotherapy cocktails
  COSMETOLOGY_SKINCARE // serums, peels, masks
  COSMETOLOGY_CONSUMABLES // syringes, gloves, cotton pads
  MASSAGE_OILS // massage & aroma oils, creams
  MASSAGE_CONSUMABLES // towels, disposable covers, stones
  GENERAL // cleaning, paper, reception supplies
}

enum StockMovementType {
  PURCHASE // received from supplier
  USAGE // consumed in procedure (auto-deducted on COMPLETED)
  ADJUSTMENT // manual stock correction
  WASTE // expired / damaged / lost
  RETURN // returned to supplier
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum EquipmentStatus {
  OPERATIONAL
  MAINTENANCE
  OUT_OF_SERVICE
}

model InventoryItem {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @db.VarChar(200)
  sku          String?           @unique @db.VarChar(100)
  category     InventoryCategory
  unit         String            @db.VarChar(20) // мл, шт, г, л, кг
  currentStock Decimal           @default(0) @map("current_stock") @db.Decimal(10, 3)
  minStock     Decimal           @default(0) @map("min_stock") @db.Decimal(10, 3)
  costPerUnit  Decimal?          @map("cost_per_unit") @db.Decimal(10, 2)
  supplier     String?           @db.VarChar(200)
  supplierId   String?           @map("supplier_id") @db.Uuid
  expiresAt    DateTime?         @map("expires_at")
  isActive     Boolean           @default(true) @map("is_active")
  notes        String?           @db.Text
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  movements     StockMovement[]
  serviceLinks  InventoryServiceLink[]
  supplierRel   Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseItems PurchaseOrderItem[]

  @@index([category, isActive])
  @@index([currentStock])
  @@map("inventory_items")
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  inventoryItemId String            @map("inventory_item_id") @db.Uuid
  type            StockMovementType
  quantity        Decimal           @db.Decimal(10, 3) // positive = in, negative = out
  balanceAfter    Decimal           @map("balance_after") @db.Decimal(10, 3)
  reason          String?           @db.VarChar(500)
  appointmentId   String?           @map("appointment_id") @db.Uuid
  userId          String?           @map("user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")

  item        InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  user        User?         @relation("InventoryMovementUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@index([appointmentId])
  @@map("stock_movements")
}

model InventoryServiceLink {
  id              String   @id @default(uuid()) @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  quantityPerUse  Decimal  @map("quantity_per_use") @db.Decimal(10, 3)
  createdAt       DateTime @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, serviceId])
  @@index([serviceId])
  @@map("inventory_service_links")
}

// ─── Supplier ─────────────────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  contactName String?  @map("contact_name") @db.VarChar(200)
  phone       String?  @db.VarChar(50)
  email       String?  @db.VarChar(200)
  address     String?  @db.Text
  website     String?  @db.VarChar(500)
  notes       String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items          InventoryItem[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
  @@map("suppliers")
}

// ─── Purchase Orders ──────────────────────────────────────────────────────────

model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  supplierId      String?             @map("supplier_id") @db.Uuid
  supplier        Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status          PurchaseOrderStatus @default(DRAFT)
  orderedAt       DateTime?           @map("ordered_at")
  expectedAt      DateTime?           @map("expected_at")
  receivedAt      DateTime?           @map("received_at")
  totalCost       Decimal             @default(0) @map("total_cost") @db.Decimal(12, 2)
  notes           String?             @db.Text
  createdByUserId String?             @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  order           PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Decimal       @db.Decimal(10, 3)
  unitCost        Decimal       @map("unit_cost") @db.Decimal(10, 2)
  receivedQty     Decimal       @default(0) @map("received_qty") @db.Decimal(10, 3)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([orderId])
  @@index([inventoryItemId])
  @@map("purchase_order_items")
}

// ═══════════════════════════════════════════════════════════════
// ROOM / CABINET MANAGEMENT
// Treatment rooms and cabinets within a location.
// ═══════════════════════════════════════════════════════════════

enum RoomType {
  MASSAGE
  COSMETOLOGY
  GENERAL
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(100)
  type       RoomType @default(GENERAL)
  locationId String   @map("location_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  notes      String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  location     Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  equipment    RoomEquipment[]

  @@index([locationId])
  @@index([locationId, type])
  @@map("rooms")
}

// ─── Room Equipment ───────────────────────────────────────────────────────────

model RoomEquipment {
  id             String          @id @default(uuid()) @db.Uuid
  roomId         String          @map("room_id") @db.Uuid
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name           String          @db.VarChar(200)
  description    String?         @db.Text
  status         EquipmentStatus @default(OPERATIONAL)
  lastServicedAt DateTime?       @map("last_serviced_at")
  nextServiceAt  DateTime?       @map("next_service_at")
  purchasedAt    DateTime?       @map("purchased_at")
  notes          String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([roomId])
  @@index([status])
  @@map("room_equipment")
}

// ═══════════════════════════════════════════════════════════════
// MASSAGE WORKLOAD OVERRIDES
// Admin-set exemptions from daily target compliance tracking.
// ═══════════════════════════════════════════════════════════════

model WorkloadOverride {
  id           String   @id @default(uuid()) @db.Uuid
  specialistId String   @map("specialist_id") @db.Uuid
  date         DateTime @db.Date
  reason       String?  @db.VarChar(500)
  overriddenBy String   @map("overridden_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@unique([specialistId, date])
  @@index([specialistId, date])
  @@index([date])
  @@map("workload_overrides")
}

// ═══════════════════════════════════════════════════════════════
// PAYROLL & COMPENSATION SYSTEM
// ═══════════════════════════════════════════════════════════════

enum CompensationType {
  FIXED_SALARY        // monthly flat salary, no commission
  COMMISSION_ONLY     // percentage/fixed per procedure
  SALARY_PLUS_COMMISSION // base + commission
  HOURLY              // tracked hours × hourly rate
  PROCEDURE_BASED     // fixed amount per completed procedure
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

enum PayrollAdjustmentType {
  BONUS_REVENUE        // top revenue bonus
  BONUS_RETENTION      // client retention bonus
  BONUS_PERFORMANCE    // general performance bonus
  BONUS_PACKAGE_SALE   // package sale commission
  BONUS_UPSELL         // upsell commission
  BONUS_TARGET_HIT     // occupancy/target bonus
  BONUS_MANUAL         // admin-set bonus
  PENALTY_NO_SHOW      // penalty for client no-shows
  PENALTY_LATENESS     // penalty for late arrivals
  PENALTY_CANCELLATION // penalty for excessive cancellations
  PENALTY_POLICY       // policy violation
  DEDUCTION_ADVANCE    // salary advance deduction
  DEDUCTION_OTHER      // other deduction
  REFUND_REVERSAL      // commission reversed due to refund
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  HOLIDAY
  SICK_LEAVE
  REMOTE
}

// ─── Specialist compensation configuration ────────────────────────────────────
model SpecialistCompensation {
  id               String           @id @default(uuid()) @db.Uuid
  specialistId     String           @unique @map("specialist_id") @db.Uuid
  type             CompensationType @default(COMMISSION_ONLY)
  baseSalary       Decimal?         @map("base_salary") @db.Decimal(12, 2)
  hourlyRate       Decimal?         @map("hourly_rate") @db.Decimal(10, 2)
  procedureRate    Decimal?         @map("procedure_rate") @db.Decimal(10, 2)
  // commission rate stored on Specialist.commissionRate; serviceOverrides adds per-service tweaks
  serviceOverrides Json?            @map("service_overrides") // { "serviceId": { "type": "pct"|"fixed", "value": number } }
  effectiveFrom    DateTime         @default(now()) @map("effective_from")
  notes            String?          @db.VarChar(500)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([specialistId])
  @@map("specialist_compensations")
}

// ─── Monthly payroll record ───────────────────────────────────────────────────
model PayrollRecord {
  id                String        @id @default(uuid()) @db.Uuid
  specialistId      String        @map("specialist_id") @db.Uuid
  periodStart       DateTime      @map("period_start") @db.Date
  periodEnd         DateTime      @map("period_end") @db.Date
  compensationType  CompensationType @map("compensation_type") @default(COMMISSION_ONLY)
  baseSalary        Decimal       @default(0) @map("base_salary") @db.Decimal(12, 2)
  totalCommission   Decimal       @default(0) @map("total_commission") @db.Decimal(12, 2)
  totalBonuses      Decimal       @default(0) @map("total_bonuses") @db.Decimal(12, 2)
  totalPenalties    Decimal       @default(0) @map("total_penalties") @db.Decimal(12, 2)
  totalDeductions   Decimal       @default(0) @map("total_deductions") @db.Decimal(12, 2)
  netPayable        Decimal       @default(0) @map("net_payable") @db.Decimal(12, 2)
  status            PayrollStatus @default(DRAFT)
  completedApts     Int           @default(0) @map("completed_apts")
  totalRevenue      Decimal       @default(0) @map("total_revenue") @db.Decimal(12, 2)
  totalRefunded     Decimal       @default(0) @map("total_refunded") @db.Decimal(12, 2)
  workingDays       Int?          @map("working_days")
  workedHours       Decimal?      @map("worked_hours") @db.Decimal(8, 2)
  metadata          Json?
  notes             String?       @db.Text
  approvedBy        String?       @map("approved_by") @db.Uuid
  approvedAt        DateTime?     @map("approved_at")
  paidAt            DateTime?     @map("paid_at")
  paidBy            String?       @map("paid_by") @db.Uuid
  createdBy         String        @map("created_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  specialist  Specialist          @relation(fields: [specialistId], references: [id], onDelete: Restrict)
  adjustments PayrollAdjustment[]

  @@unique([specialistId, periodStart, periodEnd])
  @@index([specialistId, periodStart])
  @@index([status, periodStart])
  @@map("payroll_records")
}

// ─── Payroll bonuses, penalties, manual adjustments ──────────────────────────
model PayrollAdjustment {
  id            String                @id @default(uuid()) @db.Uuid
  payrollId     String                @map("payroll_id") @db.Uuid
  type          PayrollAdjustmentType
  amount        Decimal               @db.Decimal(12, 2) // positive=credit, negative=debit
  reason        String?               @db.VarChar(500)
  appointmentId String?               @map("appointment_id") @db.Uuid
  createdBy     String                @map("created_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")

  payroll PayrollRecord @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@index([type])
  @@map("payroll_adjustments")
}

// ─── Daily attendance records ─────────────────────────────────────────────────
model AttendanceRecord {
  id             String           @id @default(uuid()) @db.Uuid
  specialistId   String           @map("specialist_id") @db.Uuid
  date           DateTime         @db.Date
  checkInAt      DateTime?        @map("check_in_at")
  checkOutAt     DateTime?        @map("check_out_at")
  breakMinutes   Int              @default(0) @map("break_minutes")
  status         AttendanceStatus @default(PRESENT)
  completedApts  Int              @default(0) @map("completed_apts")
  notes          String?          @db.VarChar(500)
  recordedBy     String?          @map("recorded_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@unique([specialistId, date])
  @@index([specialistId, date])
  @@index([date, status])
  @@map("attendance_records")
}

// ─── Risk Intelligence Engine ─────────────────────────────────────────────────

enum RiskCategory {
  DISCOUNT_ABUSE
  CASH_LEAKAGE
  PAYROLL_ANOMALY
  SLOT_MANIPULATION
  CLIENT_POACHING
  INVENTORY_SHRINKAGE
  CANCELLATION_FRAUD
  VIP_CHURN_RISK
  BURNOUT_RISK
  OPERATIONAL_ANOMALY
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model RiskAlert {
  id          String       @id @default(uuid()) @db.Uuid
  category    RiskCategory
  severity    RiskSeverity
  title       String       @db.VarChar(200)
  description String       @db.Text
  entityType  String?      @map("entity_type") @db.VarChar(50)
  entityId    String?      @map("entity_id") @db.VarChar(100)
  metadata    Json?

  isDismissed Boolean   @default(false) @map("is_dismissed")
  dismissedBy String?   @map("dismissed_by") @db.Uuid
  dismissedAt DateTime? @map("dismissed_at")
  resolvedAt  DateTime? @map("resolved_at")
  detectedAt  DateTime  @default(now()) @map("detected_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([category, isDismissed])
  @@index([severity, isDismissed])
  @@index([detectedAt])
  @@map("risk_alerts")
}
