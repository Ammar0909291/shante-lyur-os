{
 "cues": [
  {
   "id": "q",
   "t0": 0.35,
   "t1": 5.523,
   "sub": "क्या आपने कभी सोचा है कि अगर हमारी पृथ्वी अचानक रुक जाए, तो क्या होगा?"
  },
  {
   "id": "speed",
   "t0": 6.023,
   "t1": 18.262,
   "sub": "जैसा कि हम सब जानते हैं, हमारी पृथ्वी भूमध्य रेखा पर करीब 1,670 किलोमीटर प्रति घंटे की रफ़्तार से घूम रही है, और इसके साथ, इस पर मौजूद हर चीज़ भी।"
  },
  {
   "id": "stop",
   "t0": 18.812,
   "t1": 23.762,
   "sub": "अब अगर पृथ्वी रुकती है, तो हर चीज़ उसी रफ़्तार से पूरब की तरफ़ भागेगी।"
  },
  {
   "id": "bus",
   "t0": 24.262,
   "t1": 28.6,
   "sub": "जैसे चलती बस में ब्रेक लगे, तो बस रुकती है, आप आगे गिरते हो।"
  },
  {
   "id": "air",
   "t0": 29.05,
   "t1": 33.145,
   "sub": "हवा आँधी बनकर टूट पड़ेगी, और समंदर किनारों पर चढ़ आएगा।"
  },
  {
   "id": "year",
   "t0": 33.645,
   "t1": 39.825,
   "sub": "धरती रुकी, तो हमारा एक दिन, एक साल का होगा: 6 महीने धूप, 6 महीने रात।"
  },
  {
   "id": "cata",
   "t0": 40.325,
   "t1": 47.993,
   "sub": "आँधी, उफनता समंदर, और महीनों लंबी रात: मिलकर ऐसी तबाही लाएँगे, जो इंसान ने कभी नहीं देखी।"
  },
  {
   "id": "close1",
   "t0": 48.893,
   "t1": 51.248,
   "sub": "सुकून की बात, ऐसा हो नहीं सकता।"
  },
