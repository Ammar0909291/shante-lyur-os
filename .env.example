# Shante Lyur OS Pro v3 — Environment Configuration
# Copy to .env and fill in real values for production

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shante_lyur?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shante_lyur?schema=public"

# ─── Auth / JWT ────────────────────────────────────────────────
JWT_SECRET="dev-jwt-secret-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── Cookies ───────────────────────────────────────────────────
COOKIE_SECRET="dev-cookie-secret-change-in-production"
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"

# ─── YooKassa ──────────────────────────────────────────────────
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_RETURN_URL="http://localhost:3000/payment/success"
YOOKASSA_WEBHOOK_SECRET=""

# ─── Robokassa ─────────────────────────────────────────────────
ROBOKASSA_MERCHANT_LOGIN=""
ROBOKASSA_PASSWORD1=""
ROBOKASSA_PASSWORD2=""
ROBOKASSA_RETURN_URL="http://localhost:3000/payment/success"
ROBOKASSA_RESULT_URL="http://localhost:3000/api/webhooks/robokassa"

# ─── SMTP / Email ──────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@shantelyur.ru"
SMTP_SECURE="false"

# ─── SMS (optional) ────────────────────────────────────────────
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_FROM="ShanteLyur"

# ─── Redis (optional, for rate limiting & sessions) ────────────
REDIS_URL="redis://localhost:6379/0"

# ─── AI / Analytics ────────────────────────────────────────────
OPENAI_API_KEY=""

# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="Shante Lyur OS"
APP_TIMEZONE="Europe/Moscow"
NODE_ENV="development"
